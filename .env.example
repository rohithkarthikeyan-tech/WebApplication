# Django Configuration
SECRET_KEY=django-insecure-prod-environment-template-key-replace-me
DEBUG=True
ALLOWED_HOSTS=*

# MongoDB Database Connection (for Chat Logs & Feedback)
# Default is local MongoDB; on production use MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/aether_db

# AI Assistant API Keys (Optional - Local FAQ & Error Code search engine fallback active if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# External Third-Party Telemetry/Quote API Configuration
EXTERNAL_INSIGHT_API_URL=https://dummyjson.com/quotes/random
EXTERNAL_API_TIMEOUT=2.0
